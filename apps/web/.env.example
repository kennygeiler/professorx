# =============================================================================
# readXlater — Environment Variables
# =============================================================================
# Copy this to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# --- Supabase ---
# Create a free project at https://supabase.com
# Find these in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- API Key ---
# Shared secret between the web app and the Chrome extension.
# Generate with: openssl rand -hex 32
# Paste this same key into the extension popup when connecting.
API_KEY=your-api-key-here

# --- Local User ID ---
# Single-user mode. Must be a UUID — public.users.id is a UUID column, so any
# other string fails on insert with "invalid input syntax for type uuid".
# Generate one with: uuidgen | tr 'A-Z' 'a-z'
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# --- Demo Mode ---
# Set to "true" on your public Vercel deployment to show a landing page
# instead of the app. Leave unset for local use.
# DEMO_MODE=true

# --- Anthropic ---
# For AI categorization and semantic search.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
